{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "OpsSherlock",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "OpsSherlock"
  },
  "runtimes": [
    {
      "name": "OpsSherlock",
      "build": "Container",
      "entrypoint": "agent.py",
      "codeLocation": "app/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "additionalPolicies": ["policies/observability.json"],
      "envVars": [
        {
          "name": "AWS_REGION",
          "value": "eu-central-1"
        }
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}